{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ,"Serilog.Sinks.Console"],
    "WriteTo:0": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "WriteTo": [
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../logs/log_.log",
                "rollingInterval": "Day"
              }
            },
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../logs/error_log_.log",
                "rollingInterval": "Day",
                "restrictedToMinimumLevel": "Warning"
              }
            },
            {
              "Name": "Console"
            }
          ]
        }
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "Skarabeus"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "User ID=postgres;Password=MasterPassword;Host=localhost;Port=5432;Database=skarabeus_dev;Include Error Detail=true"
  },
  "SmtpSettings": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "UserName": "09b64e04f00781",
    "Password": "c236a74462a70b",
    "Sender": "info@project.management.cz"
  }
}
