{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "WriteTo:0": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "WriteTo": [
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../logs/log_.log",
                "rollingInterval": "Day"
              }
            },
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../logs/error_log_.log",
                "rollingInterval": "Day",
                "restrictedToMinimumLevel": "Warning"
              }
            },
            {
              "Name": "Console"
            }
          ]
        }
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "Skarabeus"
    }
  },

  "AllowedHosts": "*"
}
