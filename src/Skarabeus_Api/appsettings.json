{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "WriteTo:0": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "WriteTo": [
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../../logs/log_.log",
                "rollingInterval": "Day"
              }
            },
            //{
            //  "Name": "File",
            //  "Args": {
            //    "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
            //    "path": "../../../logs/log_logs_.log",
            //    "rollingInterval": "Day",
            //    "Filter": [
            //      {
            //        "Name": "ByIncludingOnly",
            //        "Args": {
            //          "expression": "{SourceContext} = 'Microsoft.AspNetCore.Hosting.Diagnostics'"
            //        }
            //      }
            //    ]
            //  }
            //},
            {
              "Name": "File",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy/MM/dd HH:mm:ss.fff} {Level:u4} <source:{SourceContext}>] {Message:lj} {Exception}{NewLine}",
                "path": "../../../logs/error_log_.log",
                "rollingInterval": "Day",
                "restrictedToMinimumLevel": "Warning"
              }
            },
            {
              "Name": "Console"
            }
          ]
        }
      }
    },

    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "Skarabeus"
    }
  },

  "JwtSettings": {
    "SecretKey": "MyExtraLongSecretKeyMUHEHEHEHEHEHEHEHEHEHEHEHEHEHEHEHEHEHEHE",
    "Issuer": "SkarabeusApi",
    "Audience": "You!!"
  },

  "AllowedHosts": "*",

  "EnvironmentSettings": {
    "FrontendHostUrl": "http://localhost:4200",
    "FrontendConfirmUrl": "/auth/validate-email",
    "FrontendPasswordResetUrl": "/auth/change-password"
  }
}
